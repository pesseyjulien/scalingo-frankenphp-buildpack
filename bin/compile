#!/usr/bin/env bash
set -euo pipefail

build_dir="$1"

if [ -z "${FRANKENPHP_BINARY_URL:-}" ]; then
    echo "FRANKENPHP_BINARY_URL must point to the static FrankenPHP artifact."
    exit 1
fi

mkdir -p "$build_dir/bin"
curl --fail --location --silent --show-error "$FRANKENPHP_BINARY_URL" --output "$build_dir/bin/frankenphp"

if [ -n "${FRANKENPHP_BINARY_SHA256:-}" ]; then
    echo "$FRANKENPHP_BINARY_SHA256  $build_dir/bin/frankenphp" | sha256sum --check --status
fi

chmod +x "$build_dir/bin/frankenphp"

# Composer scripts invoke PHP directly; expose the FrankenPHP CLI under that name.
cat > "$build_dir/bin/php" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

exec "$(dirname "$0")/frankenphp" php-cli "$@"
EOF
chmod +x "$build_dir/bin/php"
export PATH="$build_dir/bin:$PATH"
export PHP_BINARY="$build_dir/bin/php"

mkdir -p "$build_dir/.frankenphp"
cat > "$build_dir/.frankenphp/php.ini" <<'EOF'
opcache.enable = 1
opcache.memory_consumption = 192
opcache.max_accelerated_files = 20000
opcache.interned_strings_buffer = 16
opcache.validate_timestamps = 0
opcache.save_comments = 1
EOF

if [ -f "$build_dir/composer.json" ]; then
    php_includes="$(COMPOSER_JSON_PATH="$build_dir/composer.json" "$build_dir/bin/frankenphp" php-cli -r '
$composer_path = getenv("COMPOSER_JSON_PATH");
$composer_contents = file_get_contents($composer_path);
if ($composer_contents === false) {
    fwrite(STDERR, "Unable to read composer.json: {$composer_path}\n");
    exit(1);
}

$composer = json_decode($composer_contents, true);
if (json_last_error() !== JSON_ERROR_NONE) {
    fwrite(STDERR, "Invalid composer.json: " . json_last_error_msg() . "\n");
    exit(1);
}

$includes = $composer["extra"]["paas"]["php-includes"] ?? [];

if (!is_array($includes)) {
    fwrite(STDERR, "extra.paas.php-includes must be an array.\n");
    exit(1);
}

foreach ($includes as $include) {
    if (!is_string($include) || $include === "") {
        fwrite(STDERR, "Each extra.paas.php-includes entry must be a non-empty string.\n");
        exit(1);
    }

    echo $include, PHP_EOL;
}
' )"

    while IFS= read -r include_file; do
        [ -n "$include_file" ] || continue

        if [[ "$include_file" = /* ]]; then
            include_path="$include_file"
        else
            include_path="$build_dir/$include_file"
        fi

        if [ ! -f "$include_path" ]; then
            echo "PHP include file not found: $include_file" >&2
            exit 1
        fi

        printf '\n; Project PHP override: %s\n' "$include_file" >> "$build_dir/.frankenphp/php.ini"
        cat "$include_path" >> "$build_dir/.frankenphp/php.ini"
        printf '\n' >> "$build_dir/.frankenphp/php.ini"
    done <<< "$php_includes"
fi

"$build_dir/bin/frankenphp" php-cli -r '
if (PHP_MAJOR_VERSION !== 8 || PHP_MINOR_VERSION !== 5) {
    fwrite(STDERR, "FrankenPHP must embed PHP 8.5.\n");
    exit(1);
}

if (phpversion("mongodb") !== "2.1.9") {
    fwrite(STDERR, "FrankenPHP must embed ext-mongodb 2.1.9.\n");
    exit(1);
}
'

if [ -f "$build_dir/composer.json" ]; then
    curl --fail --location --silent --show-error https://getcomposer.org/composer-stable.phar --output "$build_dir/.composer.phar"
    "$build_dir/bin/frankenphp" php-cli "$build_dir/.composer.phar" install \
        --no-dev \
        --no-interaction \
        --no-progress \
        --no-scripts \
        --optimize-autoloader
    "$build_dir/bin/frankenphp" php-cli "$build_dir/.composer.phar" dump-autoload \
        --no-interaction \
        --classmap-authoritative
    "$build_dir/bin/frankenphp" php-cli "$build_dir/.composer.phar" check-platform-reqs
    rm "$build_dir/.composer.phar"
fi
