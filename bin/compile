#!/usr/bin/env bash
set -euo pipefail

build_dir="$1"

if [ -z "${FRANKENPHP_BINARY_URL:-}" ]; then
    echo "FRANKENPHP_BINARY_URL must point to the static FrankenPHP artifact."
    exit 1
fi

mkdir -p "$build_dir/bin"
curl --fail --location --silent --show-error "$FRANKENPHP_BINARY_URL" --output "$build_dir/bin/frankenphp"

if [ -n "${FRANKENPHP_BINARY_SHA256:-}" ]; then
    echo "$FRANKENPHP_BINARY_SHA256  $build_dir/bin/frankenphp" | sha256sum --check --status
fi

chmod +x "$build_dir/bin/frankenphp"

# Composer scripts invoke PHP directly; expose the FrankenPHP CLI under that name.
cat > "$build_dir/bin/php" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

exec "$(dirname "$0")/frankenphp" php-cli "$@"
EOF
chmod +x "$build_dir/bin/php"
export PATH="$build_dir/bin:$PATH"
export PHP_BINARY="$build_dir/bin/php"

"$build_dir/bin/frankenphp" php-cli -r '
if (PHP_MAJOR_VERSION !== 8 || PHP_MINOR_VERSION !== 5) {
    fwrite(STDERR, "FrankenPHP must embed PHP 8.5.\n");
    exit(1);
}

if (phpversion("mongodb") !== "2.1.9") {
    fwrite(STDERR, "FrankenPHP must embed ext-mongodb 2.1.9.\n");
    exit(1);
}
'

if [ -f "$build_dir/composer.json" ]; then
    curl --fail --location --silent --show-error https://getcomposer.org/composer-stable.phar --output "$build_dir/.composer.phar"
    "$build_dir/bin/frankenphp" php-cli "$build_dir/.composer.phar" install \
        --no-dev \
        --no-interaction \
        --no-progress \
        --no-scripts \
        --optimize-autoloader
    "$build_dir/bin/frankenphp" php-cli "$build_dir/.composer.phar" dump-autoload \
        --no-interaction \
        --no-scripts \
        --classmap-authoritative
    "$build_dir/bin/frankenphp" php-cli "$build_dir/.composer.phar" check-platform-reqs
    rm "$build_dir/.composer.phar"
fi
